[
  {
    "name": "side",
    "layer": "top",
    "position": "left",
    "width": 85,
    "margin": "39 0 8 8",
    "exclusive": true,
    "reload_style_on_change": true,
    "modules-center": [
      "group/workspace-1",
      "group/workspace-2",
      "group/workspace-3",
      "group/workspace-4",
      "group/workspace-5",
      "group/workspace-6",
      "group/workspace-7",
      "group/workspace-8",
      "group/workspace-9",
      "group/workspace-10"
    ],
    "group/workspace-1": {
      "orientation": "horizontal",
      "modules": ["custom/workspace-1", "hyprland/workspaces#apps-1"]
    },
    "group/workspace-2": {
      "orientation": "horizontal",
      "modules": ["custom/workspace-2", "hyprland/workspaces#apps-2"]
    },
    "group/workspace-3": {
      "orientation": "horizontal",
      "modules": ["custom/workspace-3", "hyprland/workspaces#apps-3"]
    },
    "group/workspace-4": {
      "orientation": "horizontal",
      "modules": ["custom/workspace-4", "hyprland/workspaces#apps-4"]
    },
    "group/workspace-5": {
      "orientation": "horizontal",
      "modules": ["custom/workspace-5", "hyprland/workspaces#apps-5"]
    },
    "group/workspace-6": {
      "orientation": "horizontal",
      "modules": ["custom/workspace-6", "hyprland/workspaces#apps-6"]
    },
    "group/workspace-7": {
      "orientation": "horizontal",
      "modules": ["custom/workspace-7", "hyprland/workspaces#apps-7"]
    },
    "group/workspace-8": {
