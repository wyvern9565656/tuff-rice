  {
    "name": "topbar",
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin": "6 8 0 -85",
    "spacing": 8,
    "exclusive": true,
    "modules-left": [
      "custom/launcher",
      "custom/control",
      "custom/notifications",
      "custom/settings"
    ],
    "modules-center": [
      "mpris"
    ],
    "modules-right": [
      "pulseaudio",
      "network",
      "custom/bluetooth",
      "cpu",
      "memory",
      "clock",
      "tray"
    ],
    "custom/launcher": {
      "format": "",
      "tooltip": false,
      "on-click": "$HOME/.config/waybar-aero/aero-launcher.sh"
    },
    "custom/notifications": {
      "exec": "$HOME/.config/waybar-aero/notification-status.sh",
      "return-type": "json",
      "format": "{text}",
      "interval": 15,
      "tooltip": true,
      "on-click": "$HOME/.config/waybar-aero/aero-control.sh notifications"
    },
    "custom/control": {
      "format": "\uf1de",
      "tooltip": "Atalhos",
      "on-click": "$HOME/.config/waybar-aero/aero-control.sh"
    },
    "custom/settings": {
      "format": "\uf013",
      "tooltip": "Centro de controle",
      "on-click": "$HOME/.config/waybar-aero/aero-control.sh control"
    },
    "mpris": {
      "format": "\uf001  {artist} - {title}",
      "format-paused": "\uf001  {artist} - {title}",
      "tooltip-format": "{player} | {album}",
      "max-length": 36,
      "on-click": "$HOME/.config/waybar-aero/aero-player.sh"
    },
    "custom/bluetooth": {
      "exec": "$HOME/.config/waybar-aero/bluetooth-status.sh",
      "return-type": "json",
      "format": "{text}",
      "interval": 30,
      "on-click": "$HOME/.config/waybar-aero/aero-control.sh bluetooth"
    },
    "clock": {
      "format-alt": "{:%a, %d %b %Y  %H:%M}",
      "tooltip": false,
      "on-click": "$HOME/.config/waybar-aero/aero-control.sh calendar"
    },
    "pulseaudio": {
      "format": "{icon}   {volume}%",
      "format-muted": "\uf026 mudo",
      "format-icons": {
        "default": [
          "\uf027",
          "\uf028"
        ]
      },
      "scroll-step": 5,
      "on-click": "$HOME/.config/waybar-aero/aero-control.sh audio",
      "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "network": {
      "format-wifi": "\uf1eb",
      "format-ethernet": "\uf0ac  Ethernet",
      "format-disconnected": "\uf071  Sem rede",
      "tooltip-format-wifi": "Wi-Fi: {essid}\n{ifname}  {ipaddr}",
      "tooltip-format-ethernet": "{ifname}  {ipaddr}",
      "on-click": "$HOME/.config/waybar-aero/aero-control.sh wifi"
    },
    "cpu": {
      "format": "CPU {usage}%",
      "tooltip-format": "Uso de CPU: {usage}%",
      "interval": 15
    },
    "memory": {
      "format": "RAM {percentage}%",
      "tooltip-format": "Memoria: {used} / {total}",
      "interval": 20
    },
    "tray": {
      "icon-size": 18,
      "spacing": 8
    }
  }
]