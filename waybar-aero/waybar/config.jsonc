    "hyprland/workspaces#apps-1": {
      "format": "{windows}",
      "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"1\" }))'",
      "all-outputs": true,
      "persistent-workspaces": {"VGA-1": ["1"]},
      "ignore-workspaces": ["^(?!1$).*$"],
      "workspace-taskbar": {
        "enable": true,
        "format": "{icon}",
        "icon-size": 22,
        "icon-theme": ["Papirus", "Qogir", "hicolor"],
        "max-icons": 1,
        "unique-icons": true,
        "on-click-window": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ window = \"address:{address}\" }))'"
      },
      "tooltip": true
    },
    "hyprland/workspaces#apps-2": {
