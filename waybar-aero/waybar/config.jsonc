    },
    "group/workspace-10": {
      "orientation": "horizontal",
      "modules": ["custom/workspace-10", "hyprland/workspaces#apps-10"]
    },
    "custom/workspace-1": {
      "exec": "$HOME/.config/waybar-aero/workspace-button.sh 1 --number-only",
      "return-type": "json",
      "format": "{text}",
      "justify": "center",
      "restart-interval": 2,
      "exec-on-event": false,
      "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"1\" }))'",
      "tooltip": true
    },
    "custom/workspace-2": {
      "exec": "$HOME/.config/waybar-aero/workspace-button.sh 2 --number-only",
